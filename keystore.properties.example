# Copy to keystore.properties (git-ignored) for local signed release builds.
# Environment variables ANDROID_KEYSTORE_PATH / ANDROID_KEYSTORE_PASSWORD /
# ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD take precedence over this file.
storeFile=../keys/mathclock/mathclock-release.p12
storePassword=CHANGE_ME
keyAlias=mathclock
keyPassword=CHANGE_ME
